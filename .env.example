PORT=3000
# Generate your own random value. Paste the SAME value into Meta's Verify token field.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
# App settings > Basic > App secret. Not your access token.
META_APP_SECRET=replace-with-your-meta-app-secret
# Keep false for dashboard webhook tests (they may contain sample recipients).
AUTO_REPLY=false
# Only required when AUTO_REPLY=true. No + or spaces in allowed numbers.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copy a supported version from the API request shown in your Meta dashboard.
META_GRAPH_API_VERSION=
ALLOWED_RECIPIENTS=
